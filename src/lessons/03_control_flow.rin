import "std/print.rin"

Mode: enum = {
    Idle,
    Walk,
    Run,
}

main: proc() -> i32 = {
    sum: i32 = 0;

    for (i: i32 = 0; i < 5; i += 1) {
        if (i == 3) {
            continue;
        }
        sum += i;
    }

    mode: Mode = Mode.Run;
    switch (mode) {
        case Mode.Idle: {
            sum += 10;
        }
        case Mode.Walk: {
            sum += 20;
        }
        default: {
            sum += 30;
        }
    }

    // Logic is C's: && and || stop as soon as the answer is known, ! negates.
    moving: b32 = mode == Mode.Walk || mode == Mode.Run;
    if (moving && !(sum > 100)) {
        sum += 1;
    }

    printfmt("sum={}\n", sum);
    return 0;
}

// What to notice
//
// 1. The loop skips 3, so it adds 0 + 1 + 2 + 4. The switch takes `default`,
//    and the last `if` adds one more: 38.
//
// 2. `||` never evaluates its right side once the left is true, and `&&` never
//    does once the left is false. That is what makes `p != null && p[0] > 0`
//    safe to write.
//
// Try this
//
// - delete `default:` and read which members the compiler says are missing
// - add a member to Mode and see which switches it lands in

