import "std/Print.rin"

// An array is not a collection. It is a run of bytes, one element after
// another, with nothing in between. Rin gives that memory four shapes, all
// read with the same `x[i]` and addressed with the same `x[i]&`:
//
//     [N]T   an array: N elements, stored inline, length in the type
//     []T    a slice: a pointer and a length, travelling together
//     *T     a pointer to exactly one T
//     [*]T   a raw pointer to "some" T -- C's pointer, unchecked

increment: proc(value: *i32) -> void = {
    value[0] += 1;   // a *T is read at [0], and only at [0]
}

// A slice parameter takes any run of i32: a whole array, part of one, or
// memory from somewhere else. The length comes with it, so the loop needs no
// second argument and `xs[i]` is checked against it.
sum: proc(xs: []const i32) -> i32 = {
    total: i32 = 0;
    for (i: u64 = 0; i < xs.length; i += 1) {
        total += xs[i];
    }
    return total;
}

main: proc() -> i32 = {
    values: [4]i32 = {};
    for (i: i32 = 0; i < 4; i += 1) {
        values[i] = i * 10;
    }

    printfmt("{} {} {} {}\n", values[0], values[1], values[2], values[3]);

    // The whole array is one object, and its size is the element size times
    // the count. No header, no length field, no bookkeeping.
    printfmt("the array is {} bytes, an element is {}\n",
             sizeof(values), sizeof(i32));

    // Where the elements actually sit. Each one starts exactly sizeof(i32)
    // bytes after the last.
    base: uintptr = cast(values[0]&, uintptr);
    for (i: i32 = 0; i < 4; i += 1) {
        printfmt("  values[{}] at +{}\n", i, cast(values[i]&, uintptr) - base);
    }

    // So `values[i]` is not a lookup. It is arithmetic:
    //     address of element i  =  base + i * sizeof(element)

    // The address of one element is a *T: it points at that element and
    // nothing else.
    first: *i32 = values[0]&;
    increment(first);
    printfmt("after increment through a pointer: {}\n", values[0]);

    // An array converts to a slice; the length comes from its type.
    printfmt("sum of all four: {}\n", sum(values));

    // `a..b` takes a sub-slice: a included, b excluded. No copy -- it is the
    // same memory with a different start and length.
    middle: []i32 = values[1..3];
    printfmt("middle has {} elements: {} {}\n", middle.length, middle[0], middle[1]);
    printfmt("sum of the middle: {}\n", sum(middle));

    // A slice writes through to the array it came from.
    middle[0] = 99;
    printfmt("values[1] is now {}\n", values[1]);

    // A raw [*]T is what C hands you: an address and no count. Indexing it is
    // unchecked, so you name the length once and get a checked slice back.
    raw: [*]i32 = values;
    checked: []i32 = raw[0..4];
    printfmt("through the raw pointer, sum = {}\n", sum(checked));

    return 0;
}

// What to notice
//
// 1. The offsets are 0, 4, 8, 12. Nothing separates the elements. That is what
//    "contiguous" means, and it is why walking an array is the fastest thing a
//    processor does -- the next element is already in cache.
//
// 2. `sizeof(values)` is 16. The array is not a pointer. It is the bytes
//    themselves, sitting in this stack frame. A slice is two words, a pointer
//    and a length, wherever it points.
//
// 3. Indexes are checked where the length is known. A constant index out of
//    range -- `values[7]`, or `first[1]` on a *T -- does not compile. A
//    variable index into an array or a slice is checked at run time in debug
//    builds and stops the program with the file and line. Only [*]T is
//    unchecked, because only there is the length unknown.
//
// 4. `sum` never asks how big its input is. The slice says.
//
// Try this
//
// - write `values[7]` and read the compile error; then make the index a
//   variable set to 7 and run it
// - pass `values[2..4]` to `sum`, then `values[3..3]` -- an empty slice is fine
// - change `[4]i32` to `[4]i64` and watch the offsets become 0, 8, 16, 24
// - open build/gen/06_arrays_and_pointers.c and find `RIN_INDEX`: that is the
//   check, and it compiles away in release builds
