import "std/Print.rin"

Point: struct = {
    x: f32;
    y: f32;
}

SpriteKind: enum = {
    Player,
    Pickup,
    Door,
}

Sprite: struct = {
    kind: SpriteKind;
    pos: Point;
}

main: proc() -> i32 = {
    s: Sprite = {};
    s.kind = SpriteKind.Player;
    s.pos.x = 3.0f;
    s.pos.y = 4.0f;

    printfmt("sprite kind={} pos=({},{})\n", cast(s.kind, i32), s.pos.x, s.pos.y);
    return 0;
}

